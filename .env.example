# AgentGuard MCP — Environment Variables
# Copy this file to .env and adjust values as needed.
# In production (Railway, Render, Fly.io) set these in the dashboard — do NOT commit .env.

# Port the HTTP server listens on.
# Railway injects PORT automatically; leave as 3000 for local development.
PORT=3000

# Maximum number of checkpoints per session file.
# When a session reaches this limit, log_checkpoint returns CHECKPOINT_LIMIT_REACHED
# instead of writing. Increase for long-running agents; decrease for tight storage budgets.
MAX_CHECKPOINTS=10000

# Session file retention TTL in days.
# Stale session files older than this will be subject to cleanup.
SESSION_TTL_DAYS=30

# Allowed CORS origins (defaults to '*' if unconfigured).
CORS_ORIGIN=*

# Circuit Breaker system configuration
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=60

# Adaptive Baseline Learning configuration
EMA_WINDOW_SIZE=20


