# AgentGuard MCP v3.1.0 — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.
# In production (Railway, Render, Fly.io) set these in the platform dashboard.
# NEVER commit your actual .env file — it is already gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================

# Port the HTTP server listens on.
# Railway/Render inject PORT automatically; leave as 3000 for local development.
PORT=3000

# Node environment — affects logging verbosity and some security defaults.
NODE_ENV=production

# ==============================================================================
# SECURITY — REQUIRED IN PRODUCTION (do not leave blank when deployed)
# ==============================================================================

# Master Admin Key — protects the Admin Console (http://your-host/admin).
# Without this set, the admin console is OPEN TO ANYONE on the internet.
# Generate with:  openssl rand -hex 32
AGENTGUARD_ADMIN_KEY=

# Master API Key — protects the /mcp MCP endpoint.
# Agents must pass this as: Authorization: Bearer <key>
# Can be the same as AGENTGUARD_ADMIN_KEY or a separate key.
# Generate with:  openssl rand -hex 32
AGENTGUARD_API_KEY=

# ==============================================================================
# DATABASE BACKEND
# ==============================================================================

# Storage backend: "sqlite" (default, VPC-local) or "postgres" (distributed).
# For 10-50 users SQLite is perfectly capable. Switch to postgres for scaling.
STORAGE_BACKEND=sqlite

# PostgreSQL connection URL — only required when STORAGE_BACKEND=postgres
# Example: postgresql://user:password@host:5432/agentguard
DATABASE_URL=

# ==============================================================================
# RATE LIMITING
# ==============================================================================

# Global requests per 15 minutes per IP address.
# 500 is appropriate for production AI agent workloads.
# (Default was 100 — too low for real agent traffic)
RATE_LIMIT_MAX=500

# ==============================================================================
# SESSION & CHECKPOINT CONFIGURATION
# ==============================================================================

# Maximum number of checkpoints per session before the agent must archive/clear.
MAX_CHECKPOINTS=10000

# Session file retention TTL in days before cleanup maintenance prunes stale data.
SESSION_TTL_DAYS=30

# ==============================================================================
# CIRCUIT BREAKER CONFIGURATION
# ==============================================================================

# Number of consecutive tool failures before a circuit trips to OPEN state.
CIRCUIT_FAILURE_THRESHOLD=5

# Seconds to wait in OPEN state before attempting half-open test request.
CIRCUIT_COOLDOWN_SECONDS=60

# ==============================================================================
# ADAPTIVE BASELINE LEARNING
# ==============================================================================

# EMA smoothing window size. Higher = smoother baseline, slower adaptation.
EMA_WINDOW_SIZE=20

# ==============================================================================
# CORS & NETWORKING
# ==============================================================================

# Allowed CORS origins. Set to your specific domain in production.
# Example: https://app.yourdomain.com
# Use * only in local development — never in production.
CORS_ORIGIN=*
